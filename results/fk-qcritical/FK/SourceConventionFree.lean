/-
# The source free-exterior-component convention is free at closed boundaries

Source: Beffara--Faipeur--Oke, arXiv:2512.16486v1, Section 5.1 (proof of
Theorem 5.1) and the definition of the free convention `Φ^f`.

The paper's convention induces, on the boundary vertices of a finite box, the
partition generated by *open exterior paths*: two boundary vertices are in the
same block when they are joined by a path of open edges outside the box.  This
is the repo's `SimpleGraphBoxData.geometry` (`openPathSetoid`).

Here we prove that this convention is *free at closed boundaries*: if every
external edge incident to a vertex of the box is closed, then the induced
boundary partition is the reference closed-exterior partition (the kernel of the
vertex embedding).  This is exactly hypothesis `IsFreeAtClosedBoundary` of
`FK.InfiniteVolume.forall_eq_of_dominated_frequently_boundaryClosed`, and it is
the step "`µ_i(·|F_{S_n}^c)` is the free boundary random cluster measure" in the
paper's proof of Theorem 5.1.
-/
import FK.ConventionTransport
import FK.CoFinalFreeUniqueness

open Filter Set MeasureTheory ProbabilityTheory Topology
open scoped ENNReal NNReal Topology ProbabilityTheory

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option linter.deprecated false

namespace FK.InfiniteVolume

universe u v

variable {V : Type u} [Countable V] {G : SimpleGraph V}

open FK.InfiniteVolume.ConventionTransport

/-! ## Open connectivity in the empty configuration -/

/-- In the configuration with every edge closed, only equal vertices are
open-connected. -/
theorem openConnected_empty_iff {A : Set (Sym2 V)} {x y : V} :
    CurvatureVariance.Infra.Percolation.OpenConnected G (fun _ => false) A x y ↔ x = y := by
  constructor
  · rintro ⟨p, hp⟩
    induction p with
    | nil => rfl
    | cons h q ih =>
      have hd : (⟨(_, _), h⟩ : G.Dart) ∈ (SimpleGraph.Walk.cons h q).darts := by
        rw [SimpleGraph.Walk.darts_cons]
        exact List.mem_cons_self ..
      have hopen := (hp _ hd).2
      simp at hopen
  · rintro rfl
    exact CurvatureVariance.Infra.Percolation.OpenConnected.refl _ _ _

/-! ## The source boundary edge set and convention -/

/-- The boundary edges of the `n`-th box: external edges incident to a vertex of
the box.  Closing exactly these edges makes the exterior condition free. -/
def SourceBoundary (box : ℕ → FiniteBox.{u, v} G.edgeSet)
    (data : SimpleGraphBoxData G box) (n : ℕ) : Set G.edgeSet :=
  {e | e ∉ (box n).edges ∧ ∃ w : (box n).Vertex,
    data.vertex n w ∈ (e.1 : Sym2 V)}

/-- The paper's free exterior-component convention as a `BoundaryAssignment`. -/
noncomputable def sourceBoundaryAssignment (exh : BoxExhaustion.{u, v} G.edgeSet)
    (data : SimpleGraphBoxData G exh.box) : BoundaryAssignment exh.box where
  partition n := data.geometry.components n
  measurable_partition n := data.measurable_components n

section ClosedBoundary

variable (box : ℕ → FiniteBox.{u, v} G.edgeSet)
  (data : SimpleGraphBoxData G box)

/-- Every open dart leaving a box vertex has to use a boundary edge, which is
closed by hypothesis. -/
theorem closeInside_eq_false_of_sourceBoundary {n : ℕ} {ω : Configuration G.edgeSet}
    (hω : ∀ e ∈ SourceBoundary box data n, ω e = false)
    {x : (box n).Vertex} {u : V} (h : G.Adj (data.vertex n x) u) :
    closeInside (box n)
        (FKLimit.exteriorRestriction (box n).edges ω)
        (⟨s(data.vertex n x, u), h⟩ : G.edgeSet) = false := by
  classical
  by_cases hin : (⟨s(data.vertex n x, u), h⟩ : G.edgeSet) ∈ (box n).edges
  · simp only [closeInside, FiniteBox.glue, dif_pos hin]
  · have hmem : data.vertex n x ∈ (((⟨s(data.vertex n x, u), h⟩ : G.edgeSet)).1 : Sym2 V) :=
      Sym2.mem_mk_left _ _
    have hbd : (⟨s(data.vertex n x, u), h⟩ : G.edgeSet) ∈ SourceBoundary box data n :=
      ⟨hin, ⟨x, hmem⟩⟩
    simp only [closeInside, FiniteBox.glue, dif_neg hin, FKLimit.exteriorRestriction]
    exact hω _ hbd

/-- With a closed boundary the open-path partition of the box is the reference
one: only equal vertices are connected. -/
theorem openPathSetoid_closeInside_eq_of_sourceBoundary {n : ℕ} {ω : Configuration G.edgeSet}
    (hω : ∀ e ∈ SourceBoundary box data n, ω e = false) :
    openPathSetoid G (closeInside (box n)
        (FKLimit.exteriorRestriction (box n).edges ω)) Set.univ (data.vertex n) =
      openPathSetoid G (fun _ => false) Set.univ (data.vertex n) := by
  classical
  apply Setoid.ext
  intro x y
  change CurvatureVariance.Infra.Percolation.OpenConnected G (closeInside (box n)
      (FKLimit.exteriorRestriction (box n).edges ω)) Set.univ
      (data.vertex n x) (data.vertex n y) ↔
    CurvatureVariance.Infra.Percolation.OpenConnected G (fun _ => false) Set.univ
      (data.vertex n x) (data.vertex n y)
  constructor
  · rintro ⟨p, hp⟩
    have haux : ∀ {u w : V} (p : G.Walk u w),
        CurvatureVariance.Infra.Percolation.IsOpenIn (closeInside (box n)
          (FKLimit.exteriorRestriction (box n).edges ω)) Set.univ p →
        (∀ (z : V) (h : G.Adj u z),
          closeInside (box n) (FKLimit.exteriorRestriction (box n).edges ω)
            (⟨s(u, z), h⟩ : G.edgeSet) = false) → u = w := by
      intro u w p
      induction p with
      | nil => intro _ _; rfl
      | cons hadj rest ih =>
        intro hp hno
        rw [CurvatureVariance.Infra.Percolation.isOpenIn_cons] at hp
        have hfalse := hno _ hadj
        exact absurd hp.1.2 (by rw [hfalse]; simp)
    exact (openConnected_empty_iff (G := G) (A := Set.univ)).mpr
      (haux p hp (fun z h => closeInside_eq_false_of_sourceBoundary box data hω h))
  · intro hxy
    refine CurvatureVariance.Infra.Percolation.OpenConnected.mono_config hxy ?_
    intro e
    simp only [Pi.zero_apply]
    simp only [closeInside, FiniteBox.glue]
    split_ifs <;> simp

/-- **The free exterior-component convention is free at closed boundaries** —
for an arbitrary finite box (equivalently an arbitrary finite region), not just
for the boxes of an exhaustion. -/
theorem openPathSetoid_components_eq_of_closedBoundary {n : ℕ}
    {ω : Configuration G.edgeSet}
    (hω : ∀ e ∈ SourceBoundary box data n, ω e = false) :
    data.geometry.components n (FKLimit.exteriorRestriction (box n).edges ω) =
      data.geometry.components n (box n).closedExterior := by
  have h1 := openPathSetoid_closeInside_eq_of_sourceBoundary box data (n := n) hω
  have h2 : closeInside (box n) (box n).closedExterior = (fun _ => false) := by
    funext e
    simp [closeInside, FiniteBox.glue, FiniteBox.closedExterior]
  show openPathSetoid G (closeInside (box n)
      (FKLimit.exteriorRestriction (box n).edges ω)) Set.univ (data.vertex n) =
    openPathSetoid G (closeInside (box n) (box n).closedExterior) Set.univ
      (data.vertex n)
  rw [h2]
  exact h1

end ClosedBoundary

/-- The free exterior-component convention of an exhaustion is free at closed
boundaries. -/
theorem isFreeAtClosedBoundary_sourceConvention (exh : BoxExhaustion.{u, v} G.edgeSet)
    (data : SimpleGraphBoxData G exh.box) :
    IsFreeAtClosedBoundary exh (sourceBoundaryAssignment exh data)
      (SourceBoundary exh.box data) :=
  fun n ω hω => openPathSetoid_components_eq_of_closedBoundary exh.box data hω




/-! ## Theorem 5.1 for the paper's free exterior-component convention -/

section Assembled

variable (exh : BoxExhaustion.{u, v} G.edgeSet)
  (data : SimpleGraphBoxData G exh.box)

/-- **Theorem 5.1 for the source convention.**  For the paper's free
exterior-component convention `Φ^f` (`sourceBoundaryAssignment`), if a law `ρ`
has closed box boundaries infinitely often almost surely and stochastically
dominates every DLR law, then the DLR class is a singleton.

The boundary/free identity is *proved* here (`isFreeAtClosedBoundary_sourceConvention`),
not assumed.  The single remaining input is the geometric closed-boundary
frequency of `ρ`, which is the paper's `ρ(Ω̃) = 1`. -/
theorem forall_eq_sourceConvention_of_dominated_frequentlyBoundaryClosed
    {q p : NNReal} (hq : 0 < q) (hp : p ≤ 1)
    (ρ : ProbabilityMeasure (Configuration G.edgeSet))
    (hρ : ∀ᵐ η ∂(ρ : Measure (Configuration G.edgeSet)),
      FrequentlyBoundaryClosed (SourceBoundary exh.box data) η)
    (hdom : ∀ μ ∈ DLRMeasures exh (sourceBoundaryAssignment exh data) hq hp,
      FKLimit.StochasticallyDominates ρ μ) :
    ∀ μ ∈ DLRMeasures exh (sourceBoundaryAssignment exh data) hq hp,
      ∀ ν ∈ DLRMeasures exh (sourceBoundaryAssignment exh data) hq hp, μ = ν :=
  forall_eq_of_dominated_frequently_boundaryClosed exh (sourceBoundaryAssignment exh data)
    hq hp (SourceBoundary exh.box data) (isFreeAtClosedBoundary_sourceConvention exh data)
    ρ hρ hdom


/-! ## Sparse laws do satisfy the closed-boundary hypothesis

The obstruction `FK.ClosedBoundaryObstruction` shows that nonpercolation alone is
not enough for a fixed exhaustion.  Here is the complementary positive statement:
if a configuration has only finitely many open edges, then for the source
boundary all but finitely many boxes have a closed boundary.  Hence every law
concentrated on such configurations satisfies the geometric hypothesis of the
uniqueness theorem. -/

/-- A configuration with finitely many open edges has closed source boundaries
for all sufficiently large boxes. -/
theorem eventually_boundaryClosed_of_finite_openEdges (exh : BoxExhaustion.{u, v} G.edgeSet)
    (data : SimpleGraphBoxData G exh.box) {η : Configuration G.edgeSet}
    (hfin : {e : G.edgeSet | η e = true}.Finite) :
    ∀ᶠ n in atTop, BoundaryClosed (SourceBoundary exh.box data) n η := by
  refine Filter.Eventually.mono (exh.eventually_subset hfin.toFinset) ?_
  intro n hn e he
  by_contra hne
  have htrue : η e = true := by
    cases hη : η e
    · exact absurd hη hne
    · rfl
  have hmem : e ∈ hfin.toFinset := by
    rw [Set.Finite.mem_toFinset]
    exact htrue
  exact he.1 (hn hmem)

/-- A law with almost surely finitely many open edges satisfies the geometric
closed-boundary hypothesis of the uniqueness theorem, for the source boundary. -/
theorem ae_frequentlyBoundaryClosed_of_ae_finite_openEdges (exh : BoxExhaustion.{u, v} G.edgeSet)
    (data : SimpleGraphBoxData G exh.box) (ρ : ProbabilityMeasure (Configuration G.edgeSet))
    (hfin : ∀ᵐ η ∂(ρ : Measure (Configuration G.edgeSet)),
      {e : G.edgeSet | η e = true}.Finite) :
    ∀ᵐ η ∂(ρ : Measure (Configuration G.edgeSet)),
      FrequentlyBoundaryClosed (SourceBoundary exh.box data) η := by
  filter_upwards [hfin] with η hη
  exact Filter.Eventually.frequently (eventually_boundaryClosed_of_finite_openEdges exh data hη)

/-- **Theorem 5.1 for the source convention under a sparse dominating law.**  If
`ρ` has almost surely finitely many open edges (e.g. any Dirac law at a finite
configuration) and dominates every DLR law, then the DLR class is a singleton. -/
theorem forall_eq_sourceConvention_of_dominated_finiteOpenEdges
    (exh : BoxExhaustion.{u, v} G.edgeSet) (data : SimpleGraphBoxData G exh.box)
    {q p : NNReal} (hq : 0 < q) (hp : p ≤ 1)
    (ρ : ProbabilityMeasure (Configuration G.edgeSet))
    (hfin : ∀ᵐ η ∂(ρ : Measure (Configuration G.edgeSet)),
      {e : G.edgeSet | η e = true}.Finite)
    (hdom : ∀ μ ∈ DLRMeasures exh (sourceBoundaryAssignment exh data) hq hp,
      FKLimit.StochasticallyDominates ρ μ) :
    ∀ μ ∈ DLRMeasures exh (sourceBoundaryAssignment exh data) hq hp,
      ∀ ν ∈ DLRMeasures exh (sourceBoundaryAssignment exh data) hq hp, μ = ν :=
  forall_eq_sourceConvention_of_dominated_frequentlyBoundaryClosed exh data hq hp ρ
    (ae_frequentlyBoundaryClosed_of_ae_finite_openEdges exh data ρ hfin) hdom

end Assembled

end FK.InfiniteVolume

