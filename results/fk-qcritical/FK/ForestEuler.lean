import FK.FinitePlanarDuality
import Mathlib.Combinatorics.SimpleGraph.Acyclic
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Finite

/-!
# The component form of Euler's identity for finite forests

For every finite acyclic simple graph, the number of edges plus the number of
connected components (including isolated vertices) is the number of vertices.
The proof partitions vertices and edges by actual connected components and uses
Mathlib's tree cardinality theorem componentwise.
-/

namespace SimpleGraph

open scoped BigOperators Classical

variable {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableEq V]
  [DecidableRel G.Adj]

/-- Vertices are partitioned by the supports of connected components. -/
lemma card_vertices_eq_sum_connectedComponents :
    Fintype.card V = ∑ C : G.ConnectedComponent, Fintype.card C := by
  classical
  simp only [← (set_fintype_card_eq_univ_iff _).mpr G.iUnion_connectedComponentSupp,
    ← Set.toFinset_card, Set.toFinset_iUnion ConnectedComponent.supp]
  rw [Finset.card_biUnion
    (fun x _ y _ hxy => Set.disjoint_toFinset.mpr
      (pairwise_disjoint_supp_connectedComponent G hxy))]
  apply Finset.sum_congr rfl
  intro C _
  rw [Set.toFinset_card]
  congr 1
  apply Subsingleton.elim

/-- Every edge lies in exactly one ambient connected-component graph. -/
lemma edgeFinset_eq_biUnion_connectedComponents :
    G.edgeFinset = Finset.univ.biUnion
      (fun C : G.ConnectedComponent => C.toSimpleGraph.spanningCoe.edgeFinset) := by
  classical
  ext e
  constructor
  · intro he
    induction e using Sym2.inductionOn with
    | hf v w =>
      rw [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet] at he
      simp only [Finset.mem_biUnion, Finset.mem_univ, true_and,
        SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet,
        ConnectedComponent.adj_spanningCoe_toSimpleGraph]
      exact ⟨G.connectedComponentMk v, ConnectedComponent.connectedComponentMk_mem, he⟩
  · intro he
    rcases Finset.mem_biUnion.mp he with ⟨C, -, hC⟩
    induction e using Sym2.inductionOn with
    | hf v w =>
      rw [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet,
        ConnectedComponent.adj_spanningCoe_toSimpleGraph] at hC
      exact SimpleGraph.mem_edgeFinset.mpr hC.2

/-- The ambient edge count is the sum of the edge counts in the connected
components. -/
lemma card_edges_eq_sum_connectedComponents :
    G.edgeFinset.card = ∑ C : G.ConnectedComponent, C.toSimpleGraph.edgeFinset.card := by
  classical
  rw [edgeFinset_eq_biUnion_connectedComponents, Finset.card_biUnion]
  · apply Finset.sum_congr rfl
    intro C _
    exact SimpleGraph.card_edgeFinset_map _ _
  · intro C _ D _ hCD
    change Disjoint C.toSimpleGraph.spanningCoe.edgeFinset
      D.toSimpleGraph.spanningCoe.edgeFinset
    rw [Finset.disjoint_left]
    intro e heC heD
    induction e using Sym2.inductionOn with
    | hf v w =>
      rw [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet,
        ConnectedComponent.adj_spanningCoe_toSimpleGraph] at heC heD
      exact hCD (ConnectedComponent.eq_of_common_vertex heC.1 heD.1)

/-- **Forest Euler identity.** Edges plus connected components equals vertices,
with isolated vertices counted as components. -/
lemma IsAcyclic.card_edges_add_components (hG : G.IsAcyclic) :
    G.edgeFinset.card + Fintype.card G.ConnectedComponent = Fintype.card V := by
  classical
  calc
    G.edgeFinset.card + Fintype.card G.ConnectedComponent =
        (∑ C : G.ConnectedComponent, C.toSimpleGraph.edgeFinset.card) +
          ∑ _C : G.ConnectedComponent, 1 := by
      rw [card_edges_eq_sum_connectedComponents]
      simp
    _ = ∑ C : G.ConnectedComponent, (C.toSimpleGraph.edgeFinset.card + 1) := by
      rw [Finset.sum_add_distrib]
    _ = ∑ C : G.ConnectedComponent, Fintype.card C := by
      apply Finset.sum_congr rfl
      intro C _
      exact (hG.isTree_connectedComponent C).card_edgeFinset
    _ = Fintype.card V := (card_vertices_eq_sum_connectedComponents G).symm

/-- Natural-cardinal form of the forest Euler identity, convenient for FK
component counts. -/
lemma IsAcyclic.natCard_edges_add_components (hG : G.IsAcyclic) :
    Nat.card G.edgeSet + Nat.card G.ConnectedComponent = Nat.card V := by
  classical
  simpa [Nat.card_eq_fintype_card, SimpleGraph.edgeFinset_card] using
    hG.card_edges_add_components

end SimpleGraph


namespace SimpleGraph

open scoped BigOperators Classical

variable {V : Type*} [Fintype V] (G : SimpleGraph V) [DecidableEq V]
  [DecidableRel G.Adj] [Fintype G.edgeSet]

/-- Open labelled bonds of a Boolean configuration. -/
abbrev openBonds (ω : G.edgeSet → Bool) := {e : G.edgeSet // ω e = true}

/-- The simple graph generated by the open labelled bonds. -/
def configurationGraph (ω : G.edgeSet → Bool) : SimpleGraph V :=
  SimpleGraph.fromEdgeSet ((fun e : G.edgeSet => (e : Sym2 V)) ''
    {e | ω e = true})

omit [Fintype V] [DecidableEq V] [DecidableRel G.Adj] [Fintype G.edgeSet] in
lemma configurationGraph_le (ω : G.edgeSet → Bool) : G.configurationGraph ω ≤ G := by
  rw [configurationGraph, SimpleGraph.fromEdgeSet_le]
  intro e he
  rcases he.1 with ⟨b, -, rfl⟩
  exact b.property

omit [Fintype V] [DecidableEq V] [DecidableRel G.Adj] [Fintype G.edgeSet] in
lemma configurationGraph_isAcyclic (ω : G.edgeSet → Bool) (hG : G.IsAcyclic) :
    (G.configurationGraph ω).IsAcyclic :=
  hG.anti (G.configurationGraph_le ω)

/-- An open labelled bond is an edge of the generated configuration graph. -/
def openBondToEdge (ω : G.edgeSet → Bool) (e : G.openBonds ω) :
    (G.configurationGraph ω).edgeSet :=
  ⟨e.1.1, by
    rw [configurationGraph, SimpleGraph.edgeSet_fromEdgeSet]
    exact ⟨⟨e.1, e.2, rfl⟩, G.not_isDiag_of_mem_edgeSet e.1.property⟩⟩

omit [Fintype V] [DecidableEq V] [DecidableRel G.Adj] [Fintype G.edgeSet] in
lemma exists_openBond_of_mem_configurationGraph (ω : G.edgeSet → Bool)
    {x : Sym2 V} (hx : x ∈ (G.configurationGraph ω).edgeSet) :
    ∃ e : G.edgeSet, ω e = true ∧ (e : Sym2 V) = x := by
  rw [configurationGraph, SimpleGraph.edgeSet_fromEdgeSet] at hx
  rcases hx.1 with ⟨e, he, rfl⟩
  exact ⟨e, he, rfl⟩

/-- The open labelled bonds are exactly the edges of the configuration graph. -/
noncomputable def openBondEquiv (ω : G.edgeSet → Bool) :
    G.openBonds ω ≃ (G.configurationGraph ω).edgeSet where
  toFun := G.openBondToEdge ω
  invFun x :=
    let h := G.exists_openBond_of_mem_configurationGraph ω x.property
    ⟨h.choose, h.choose_spec.1⟩
  left_inv e := by
    apply Subtype.ext
    apply Subtype.ext
    exact (G.exists_openBond_of_mem_configurationGraph ω
      (G.openBondToEdge ω e).property).choose_spec.2
  right_inv x := by
    apply Subtype.ext
    exact (G.exists_openBond_of_mem_configurationGraph ω x.property).choose_spec.2

omit [Fintype V] [DecidableEq V] [DecidableRel G.Adj] in
lemma natCard_configurationGraph_edges (ω : G.edgeSet → Bool) :
    Nat.card (G.configurationGraph ω).edgeSet = FK.FinitePlane.openCard ω := by
  classical
  calc
    Nat.card (G.configurationGraph ω).edgeSet = Nat.card (G.openBonds ω) :=
      (Nat.card_congr (G.openBondEquiv ω)).symm
    _ = Fintype.card (G.openBonds ω) := Nat.card_eq_fintype_card
    _ = (Finset.univ.filter fun e : G.edgeSet => ω e).card := by
      rw [Fintype.card_subtype]
    _ = FK.FinitePlane.openCard ω := rfl

end SimpleGraph

namespace FK.FinitePlane

open scoped BigOperators Classical

/-- FK component-count Euler identity for every configuration in an ambient
finite simple forest. Both the components and the open edges are computed from
the actual generated configuration graph. -/
lemma components_add_openCard_of_isAcyclic {V : Type*} [Fintype V]
    (G : SimpleGraph V) [DecidableEq V] [DecidableRel G.Adj] [Fintype G.edgeSet]
    (hG : G.IsAcyclic) (ω : G.edgeSet → Bool) :
    Nat.card (G.configurationGraph ω).ConnectedComponent + openCard ω = Fintype.card V := by
  classical
  have h := (G.configurationGraph_isAcyclic ω hG).natCard_edges_add_components
  rw [G.natCard_configurationGraph_edges] at h
  simpa only [Nat.card_eq_fintype_card, add_comm] using h

end FK.FinitePlane
