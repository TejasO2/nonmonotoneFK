import FK.TripleCoupling

/-!
# Sequential ordered couplings with exact revealed-prefix continuations

This file formalizes the probabilistic mechanism used in inward exploration.
One new ordered pair of bits is revealed at a time.  The first bit conditional
may depend on the revealed first history, and the second bit conditional may
depend on the revealed second history.  Nevertheless the two processes can be
sampled jointly through any ordered one-bit coupling.

After any fixed pair of revealed histories, the remaining joint law has the
first continuation determined by the first history alone and the second
continuation determined by the second history alone.  This is the property
needed when the revealed exterior is a maximal exploration stratum: replacing
the remaining first configuration by its exact conditional FK law does not
change either global marginal, and the upper configuration remains product.
No graph result or whole-paper coupling statement is assumed here.
-/

namespace FK.Exploration.Sequential

open scoped ENNReal BigOperators

/-- Reveal `n` further pairs of bits, appending them to the two histories.
The one-step law may use both revealed histories. -/
noncomputable def extendPair
    (step : List Bool → List Bool → PMF (Bool × Bool))
    (x y : List Bool) : ℕ → PMF (List Bool × List Bool)
  | 0 => PMF.pure (x, y)
  | n + 1 => (step x y).bind fun z =>
      extendPair step (x ++ [z.1]) (y ++ [z.2]) n

/-- The first-history process obtained by revealing one bit at a time. -/
noncomputable def extendLower
    (bit : List Bool → PMF Bool) (x : List Bool) : ℕ → PMF (List Bool)
  | 0 => PMF.pure x
  | n + 1 => (bit x).bind fun b => extendLower bit (x ++ [b]) n

/-- Appending one related bit preserves a pointwise relation on histories. -/
lemma forall₂_append_singleton {R : Bool → Bool → Prop} {x y : List Bool}
    {a b : Bool} (hxy : List.Forall₂ R x y) (hab : R a b) :
    List.Forall₂ R (x ++ [a]) (y ++ [b]) := by
  induction hxy with
  | nil => exact List.Forall₂.cons hab List.Forall₂.nil
  | cons h _ ih => exact List.Forall₂.cons h ih

/-- The first marginal of the sequential joint law is generated by its
one-bit first conditionals.  The second history is allowed to occur in the
one-step coupling, but its first marginal may not depend on that history. -/
theorem extendPair_map_fst
    (step : List Bool → List Bool → PMF (Bool × Bool))
    (lower : List Bool → PMF Bool)
    (hfst : ∀ x y, (step x y).map Prod.fst = lower x)
    (x y : List Bool) (n : ℕ) :
    (extendPair step x y n).map Prod.fst = extendLower lower x n := by
  induction n generalizing x y with
  | zero => simpa [extendPair, extendLower] using PMF.pure_map Prod.fst (x, y)
  | succ n ih =>
      calc
        (extendPair step x y (n + 1)).map Prod.fst =
            (step x y).bind (fun z =>
              (extendPair step (x ++ [z.1]) (y ++ [z.2]) n).map Prod.fst) :=
          PMF.map_bind _ _ _
        _ = (step x y).bind (fun z => extendLower lower (x ++ [z.1]) n) := by
          congr 1
          funext z
          exact ih _ _
        _ = ((step x y).map Prod.fst).bind
            (fun b => extendLower lower (x ++ [b]) n) := by
          rw [PMF.bind_map]
          rfl
        _ = (lower x).bind (fun b => extendLower lower (x ++ [b]) n) := by
          rw [hfst]
        _ = extendLower lower x (n + 1) := rfl

/-- The second marginal is generated by the one-bit second conditionals,
with the analogous independence of the other revealed history. -/
theorem extendPair_map_snd
    (step : List Bool → List Bool → PMF (Bool × Bool))
    (upper : List Bool → PMF Bool)
    (hsnd : ∀ x y, (step x y).map Prod.snd = upper y)
    (x y : List Bool) (n : ℕ) :
    (extendPair step x y n).map Prod.snd = extendLower upper y n := by
  induction n generalizing x y with
  | zero => simpa [extendPair, extendLower] using PMF.pure_map Prod.snd (x, y)
  | succ n ih =>
      calc
        (extendPair step x y (n + 1)).map Prod.snd =
            (step x y).bind (fun z =>
              (extendPair step (x ++ [z.1]) (y ++ [z.2]) n).map Prod.snd) :=
          PMF.map_bind _ _ _
        _ = (step x y).bind (fun z => extendLower upper (y ++ [z.2]) n) := by
          congr 1
          funext z
          exact ih _ _
        _ = ((step x y).map Prod.snd).bind
            (fun b => extendLower upper (y ++ [b]) n) := by
          rw [PMF.bind_map]
          rfl
        _ = (upper y).bind (fun b => extendLower upper (y ++ [b]) n) := by
          rw [hsnd]
        _ = extendLower upper y (n + 1) := rfl

/-- Chronological concatenation of the sequential joint process. -/
theorem extendPair_add
    (step : List Bool → List Bool → PMF (Bool × Bool))
    (x y : List Bool) (m n : ℕ) :
    extendPair step x y (m + n) =
      (extendPair step x y m).bind fun z => extendPair step z.1 z.2 n := by
  induction m generalizing x y with
  | zero => simp [extendPair]
  | succ m ih =>
      simp only [Nat.succ_add, extendPair]
      rw [PMF.bind_bind]
      congr 1
      funext z
      rw [ih]

/-- Chronological concatenation for either one-coordinate process. -/
theorem extendLower_add
    (lower : List Bool → PMF Bool) (x : List Bool) (m n : ℕ) :
    extendLower lower x (m + n) =
      (extendLower lower x m).bind fun z => extendLower lower z n := by
  induction m generalizing x with
  | zero => simp [extendLower]
  | succ m ih =>
      simp only [Nat.succ_add, extendLower]
      rw [PMF.bind_bind]
      congr 1
      funext b
      rw [ih]

/-- Exact revealed-prefix/remainder factorization.  On the right, the
continuation joint law is evaluated at the already revealed pair; its two
marginals are precisely `extendLower` at the two respective histories by
`extendPair_map_fst` and `extendPair_map_snd`. -/
theorem revealedPair_bind_remainder
    (step : List Bool → List Bool → PMF (Bool × Bool))
    (x y : List Bool) (m n : ℕ) :
    extendPair step x y (m + n) =
      (extendPair step x y m).bind fun z => extendPair step z.1 z.2 n :=
  extendPair_add step x y m n

/-- Every supported realization of the sequential joint process is ordered,
provided every supported one-bit realization is ordered and the initial
histories are ordered. -/
theorem extendPair_ordered
    (step : List Bool → List Bool → PMF (Bool × Bool))
    (hstep : ∀ x y z, z ∈ (step x y).support → z.1 ≤ z.2)
    {x y : List Bool} (hxy : List.Forall₂ (fun a b : Bool => a ≤ b) x y)
    (n : ℕ) {z : List Bool × List Bool}
    (hz : z ∈ (extendPair step x y n).support) :
    List.Forall₂ (fun a b : Bool => a ≤ b) z.1 z.2 := by
  induction n generalizing x y z with
  | zero =>
      have h : z = (x, y) := (PMF.mem_support_pure_iff _ _).mp hz
      subst z
      exact hxy
  | succ n ih =>
      rw [extendPair, PMF.mem_support_bind_iff] at hz
      obtain ⟨w, hw, hz⟩ := hz
      exact ih (forall₂_append_singleton hxy (hstep x y w hw)) hz

/-- Two conditional kernels which agree on the support of the initial law have
identical binds. -/
lemma bind_congr_support {α β : Type*} (p : PMF α) (K L : α → PMF β)
    (h : ∀ a ∈ p.support, K a = L a) : p.bind K = p.bind L := by
  apply PMF.ext
  intro b
  simp only [PMF.bind_apply]
  apply tsum_congr
  intro a
  by_cases ha : a ∈ p.support
  · rw [h a ha]
  · have hzero : p a = 0 := (PMF.apply_eq_zero_iff p a).mpr ha
    simp [hzero]

/-- A bind of one fixed distribution on every support point is that
same distribution. -/
lemma bind_eq_self_of_forall_support {α β : Type*} (p : PMF α)
    (K : α → PMF β) (Q : PMF β) (h : ∀ z ∈ p.support, K z = Q) :
    p.bind K = Q := by
  calc
    p.bind K = p.bind (fun _ => Q) :=
      bind_congr_support p K (fun _ => Q) (fun z hz => h z hz)
    _ = Q := by
      apply PMF.ext
      intro b
      simp only [PMF.bind_apply]
      rw [ENNReal.tsum_mul_right, p.tsum_coe, one_mul]

/-- If every supported conditional kernel is the same point mass, their bind
is that point mass.  This is the normalized joint-law aggregation step after
conditioning on an upper stratum. -/
lemma bind_eq_pure_of_forall_support {α β : Type*} (p : PMF α)
    (K : α → PMF β) (a : β) (h : ∀ z ∈ p.support, K z = PMF.pure a) :
    p.bind K = PMF.pure a := by
  calc
    p.bind K = p.bind (fun _ => PMF.pure a) :=
      bind_congr_support p K (fun _ => PMF.pure a) (fun z hz => h z hz)
    _ = p.map (Function.const α a) := by
      simpa only [Function.comp_def, Function.const_apply] using PMF.bind_pure_comp (Function.const α a) p
    _ = PMF.pure a := PMF.map_const p a

/-- The two output histories of a sequential pair each gain exactly the number
of revealed coordinates. -/
theorem extendPair_length_support
    (step : List Bool → List Bool → PMF (Bool × Bool))
    (x y : List Bool) (n : ℕ) {z : List Bool × List Bool}
    (hz : z ∈ (extendPair step x y n).support) :
    z.1.length = x.length + n ∧ z.2.length = y.length + n := by
  induction n generalizing x y z with
  | zero =>
      have h : z = (x, y) := (PMF.mem_support_pure_iff _ _).mp hz
      subst z
      exact ⟨rfl, rfl⟩
  | succ n ih =>
      rw [extendPair, PMF.mem_support_bind_iff] at hz
      obtain ⟨w, hw, hz⟩ := hz
      obtain ⟨h1, h2⟩ := ih (x ++ [w.1]) (y ++ [w.2]) hz
      exact ⟨by simp only [List.length_append, List.length_singleton] at h1 ⊢; omega,
        by simp only [List.length_append, List.length_singleton] at h2 ⊢; omega⟩

end FK.Exploration.Sequential
