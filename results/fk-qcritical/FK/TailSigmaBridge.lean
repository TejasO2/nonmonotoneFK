/-
# Tail measurability of percolation events and the zero--one law

A measurable event of edge configurations that depends only on the edges outside
every finite set is measurable for the tail sigma-algebra `FKLimit.tailSigma`.
Combined with the Kolmogorov zero--one argument of `ClusterTail`, this gives:

* the Kolmogorov zero--one law for the tail sigma-algebra of an i.i.d. Bernoulli
  edge law;
* that for an extremal DLR law the probability of the event "an infinite open
  cluster exists" is zero or one.
-/
import FK.ClusterTail
import FK.ExtremalTail
import FK.ConventionTransport

open MeasureTheory ProbabilityTheory MeasurableSpace
open scoped ENNReal unitInterval

attribute [local instance] Classical.propDecidable

namespace FK.ClusterTail

open CurvatureVariance.Infra.Percolation
open FK.ClusterCover

variable {E : Type*}

/-! ### Extending an exterior configuration -/

/-- Extend a configuration off a finite edge set by closed edges. -/
noncomputable def extendOff (S : Finset E) (x : {e : E // e ∉ S} → Bool) :
    FKLimit.Configuration E :=
  fun i => if h : i ∈ S then false else x ⟨i, h⟩

lemma extendOff_apply (S : Finset E) (x : {e : E // e ∉ S} → Bool) (i : E) :
    extendOff S x i = if h : i ∈ S then false else x ⟨i, h⟩ := by
  rw [extendOff]

lemma measurable_extendOff (S : Finset E) : Measurable (extendOff (E := E) S) := by
  classical
  refine measurable_pi_iff.mpr fun i => ?_
  have hfun : (fun x : {e : E // e ∉ S} → Bool => extendOff S x i) =
      fun x => if h : i ∈ S then false else x ⟨i, h⟩ := by
    funext x
    exact extendOff_apply S x i
  rw [hfun]
  by_cases h : i ∈ S
  · simp only [h, dite_true]
    exact measurable_const
  · simp only [h, dite_false]
    exact measurable_pi_apply (⟨i, h⟩ : {e : E // e ∉ S})

lemma exteriorRestriction_extendOff (S : Finset E) (x : {e : E // e ∉ S} → Bool) :
    FKLimit.exteriorRestriction S (extendOff S x) = x := by
  funext e
  rw [FKLimit.exteriorRestriction, extendOff_apply]
  simp only [e.2, dite_false]

lemma extendOff_agrees (S : Finset E) (ω : FKLimit.Configuration E) :
    ∀ i, i ∉ S → extendOff S (FKLimit.exteriorRestriction S ω) i = ω i := by
  intro i hi
  rw [extendOff_apply]
  simp only [hi, dite_false, FKLimit.exteriorRestriction]

/-- **Finite-section lemma.**  A measurable event that depends only on the edges
outside a finite set is measurable for the sigma-algebra generated by those
edges. -/
theorem measurableSet_outsideSigma_of_dependsOn (S : Finset E)
    {A : Set (FKLimit.Configuration E)} (hAmeas : MeasurableSet A)
    (hdep : DependsOn (· ∈ A) ((S : Set E))ᶜ) :
    MeasurableSet[FKLimit.outsideSigma S] A := by
  classical
  rw [FKLimit.outsideSigma, measurableSet_comap]
  refine ⟨{x | extendOff S x ∈ A}, hAmeas.preimage (measurable_extendOff S), ?_⟩
  ext ω
  constructor
  · intro hω
    have hsat := hdep (extendOff_agrees S ω)
    exact Eq.mp hsat hω
  · intro hω
    have hsat := hdep (extendOff_agrees S ω)
    exact Eq.mpr hsat hω

/-- A tail-measurable event is measurable for the tail sigma-algebra. -/
theorem measurableSet_tailSigma_of_dependsOn {A : Set (FKLimit.Configuration E)}
    (hAmeas : MeasurableSet A)
    (hdep : ∀ S : Finset E, DependsOn (· ∈ A) ((S : Set E))ᶜ) :
    MeasurableSet[FKLimit.tailSigma] A :=
  MeasurableSpace.measurableSet_iInf.mpr fun S =>
    measurableSet_outsideSigma_of_dependsOn S hAmeas (hdep S)

/-- Converse direction: an event measurable for the exterior sigma-algebra only
depends on the edges outside the finite set. -/
theorem dependsOn_of_measurableSet_outsideSigma {S : Finset E}
    {A : Set (FKLimit.Configuration E)} (h : MeasurableSet[FKLimit.outsideSigma S] A) :
    DependsOn (· ∈ A) ((S : Set E))ᶜ := by
  rw [FKLimit.outsideSigma, measurableSet_comap] at h
  obtain ⟨B, -, rfl⟩ := h
  intro a b hab
  have hAB : FKLimit.exteriorRestriction S a = FKLimit.exteriorRestriction S b := by
    funext e
    exact hab e.1 e.2
  show (FKLimit.exteriorRestriction S a ∈ B) = (FKLimit.exteriorRestriction S b ∈ B)
  rw [hAB]

/-- **Characterisation of the tail sigma-algebra.**  A set of edge
configurations is measurable for `FKLimit.tailSigma` exactly when it is
(Borel-)measurable and its indicator is invariant under changing finitely many
edges. -/
theorem measurableSet_tailSigma_iff {A : Set (FKLimit.Configuration E)} :
    MeasurableSet[FKLimit.tailSigma] A ↔
      MeasurableSet A ∧ ∀ S : Finset E, DependsOn (· ∈ A) ((S : Set E))ᶜ := by
  constructor
  · intro hA
    refine ⟨FKLimit.tailSigma_le A hA, fun S => ?_⟩
    exact dependsOn_of_measurableSet_outsideSigma (FKLimit.tailSigma_le_outsideSigma S A hA)
  · rintro ⟨hAmeas, hdep⟩
    exact measurableSet_tailSigma_of_dependsOn hAmeas hdep

/-! ### Zero--one laws -/

/-- **Kolmogorov zero--one law** for the tail sigma-algebra of edge
configurations under an i.i.d. Bernoulli edge law. -/
theorem zeroOneOn_tailSigma_bernoulliProduct (p : I) :
    FK.ZeroOneOn (FKLimit.tailSigma (E := E)) (bernoulliProduct E p) := by
  intro A hA
  refine bernoulliProduct_eq_zero_or_one p (FKLimit.tailSigma_le A hA) fun S => ?_
  exact dependsOn_of_measurableSet_outsideSigma
    (FKLimit.tailSigma_le_outsideSigma S A hA)

/-- The existence of an infinite open cluster is a tail-measurable event. -/
theorem measurableSet_hasInfiniteCluster_tailSigma {V : Type*} [Countable V]
    (G : SimpleGraph V) :
    MeasurableSet[FKLimit.tailSigma (E := G.edgeSet)]
      {ω : FKLimit.Configuration G.edgeSet | HasInfiniteCluster G ω} :=
  measurableSet_tailSigma_of_dependsOn (measurableSet_hasInfiniteCluster G)
    fun S => dependsOn_hasInfiniteCluster G (S : Set G.edgeSet) S.finite_toSet

/-- A zero--one tail law assigns probability zero or one to the existence of an
infinite open cluster. -/
theorem zero_one_hasInfiniteCluster_of_zeroOneOn_tail {V : Type*} [Countable V]
    (G : SimpleGraph V) {μ : Measure (G.edgeSet → Bool)}
    (htail : FK.ZeroOneOn (FKLimit.tailSigma (E := G.edgeSet)) μ) :
    μ {ω | HasInfiniteCluster G ω} = 0 ∨ μ {ω | HasInfiniteCluster G ω} = 1 :=
  htail _ (measurableSet_hasInfiniteCluster_tailSigma G)

/-- Under an i.i.d. Bernoulli edge law, an infinite open cluster exists a.s. or
a.s. does not exist. -/
theorem percolation_hasInfiniteCluster_zero_one_pi {V : Type*} [Countable V]
    (G : SimpleGraph V) (p : I) :
    bernoulliProduct G.edgeSet p {ω | HasInfiniteCluster G ω} = 0 ∨
      bernoulliProduct G.edgeSet p {ω | HasInfiniteCluster G ω} = 1 :=
  zero_one_hasInfiniteCluster_of_zeroOneOn_tail G (zeroOneOn_tailSigma_bernoulliProduct p)

/-- **Extremal DLR zero--one law.**  For an extremal DLR law of a finite-box FK
specification on the edge set of a graph, the event that an infinite open
cluster exists has measure zero or one. -/
theorem zero_one_hasInfiniteCluster_of_extremal_dlr {V : Type u} [Countable V]
    (G : SimpleGraph V) (exh : FK.InfiniteVolume.BoxExhaustion.{u, v} G.edgeSet)
    (Φ : FK.InfiniteVolume.BoundaryAssignment exh.box) {q p : NNReal} (hq : 0 < q) (hp : p ≤ 1)
    (μ : ProbabilityMeasure (FKLimit.Configuration G.edgeSet))
    (hμ : μ ∈ FK.InfiniteVolume.DLRMeasures exh Φ hq hp)
    (hext : FK.IsExtremalIn
      ((fun ν : ProbabilityMeasure (FKLimit.Configuration G.edgeSet) =>
        (ν : Measure (FKLimit.Configuration G.edgeSet))) '' FK.InfiniteVolume.DLRMeasures exh Φ hq hp)
      (μ : Measure (FKLimit.Configuration G.edgeSet))) :
    (μ : Measure (FKLimit.Configuration G.edgeSet)) {ω | HasInfiniteCluster G ω} = 0 ∨
      (μ : Measure (FKLimit.Configuration G.edgeSet)) {ω | HasInfiniteCluster G ω} = 1 :=
  zero_one_hasInfiniteCluster_of_zeroOneOn_tail G
    (FK.InfiniteVolume.zeroOneOn_tailSigma_of_extremal_dlr exh Φ hq hp μ hμ hext)

/-- **No infinite cluster a.s. makes every root subcritical.** -/
theorem percolationProb_eq_zero_of_hasInfiniteCluster_zero {V : Type*} [Countable V]
    (G : SimpleGraph V) {p : I}
    (h : percolation G p {ω | HasInfiniteCluster G ω} = 0) (o : V) :
    percolationProb G o p = 0 := by
  rw [percolationProb_eq]
  refine measure_mono_null ?_ h
  intro ω hω
  exact ⟨o, by rw [clusterAvoid_empty_eq]; exact hω⟩

/-- **Dichotomy for i.i.d. Bernoulli bond percolation**: either an infinite open
cluster exists almost surely, or the percolation probability of every root
vanishes. -/
theorem percolation_dichotomy {V : Type*} [Countable V] (G : SimpleGraph V) (p : I) :
    percolation G p {ω | HasInfiniteCluster G ω} = 1 ∨ ∀ o, percolationProb G o p = 0 := by
  rcases percolation_hasInfiniteCluster_zero_one G p with h | h
  · exact Or.inr fun o => percolationProb_eq_zero_of_hasInfiniteCluster_zero G h o
  · exact Or.inl h

/-- **Unique infinite cluster.**  Under a zero--one tail law that almost surely
has at most one infinite open cluster, the event of possessing an infinite open
cluster (equivalently, up to that a.s. hypothesis, a unique one) has probability
zero or one. -/
theorem zero_one_hasUniqueInfiniteCluster_of_zeroOneOn_tail {V : Type*} [Countable V]
    (G : SimpleGraph V) {μ : Measure (G.edgeSet → Bool)} [IsProbabilityMeasure μ]
    (htail : FK.ZeroOneOn (FKLimit.tailSigma (E := G.edgeSet)) μ)
    (hG : μ {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω} = 1) :
    μ ({ω | HasInfiniteCluster G ω} ∩
        {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}) = 0 ∨
      μ ({ω | HasInfiniteCluster G ω} ∩
        {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}) = 1 := by
  have hBmem : MeasurableSet
      {ω : G.edgeSet → Bool | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω} :=
    FK.InfiniteVolume.ConventionTransport.measurableSet_globalAtMostOne G
  have hded : μ ({ω | HasInfiniteCluster G ω} ∩
      {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}) =
      μ {ω | HasInfiniteCluster G ω} := by
    refine le_antisymm (measure_mono Set.inter_subset_left) ?_
    calc μ {ω | HasInfiniteCluster G ω}
        ≤ μ (({ω | HasInfiniteCluster G ω} ∩
              {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}) ∪
              {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}ᶜ) := by
          refine measure_mono fun x hx => ?_
          by_cases h : x ∈ {ω : G.edgeSet → Bool |
              FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}
          · exact Or.inl ⟨hx, h⟩
          · exact Or.inr h
      _ ≤ μ ({ω | HasInfiniteCluster G ω} ∩
              {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}) +
            μ {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}ᶜ :=
          measure_union_le _ _
      _ = μ ({ω | HasInfiniteCluster G ω} ∩
              {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}) + 0 := by
          rw [measure_compl hBmem (measure_ne_top μ _), hG, measure_univ, tsub_self]
      _ = μ ({ω | HasInfiniteCluster G ω} ∩
              {ω | FK.InfiniteVolume.ConventionTransport.GlobalAtMostOne G ω}) := add_zero _
  rw [hded]
  exact zero_one_hasInfiniteCluster_of_zeroOneOn_tail G htail

end FK.ClusterTail
