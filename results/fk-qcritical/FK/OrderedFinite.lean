import FK.Glauber
import FK.JointProductInvariance

/-!
# Ordered couplings for finite heat-bath kernels

A shared-clock coupling of single-coordinate updates, together with ordered
composition through finite-time laws.  The conditional-law inputs are supplied
by the measures being compared.
-/

namespace GlauberCoupling

noncomputable section
open scoped Classical BigOperators

open Set Filter
open OpenPath

variable {α β γ : Type*}

lemma map_map [Fintype α] [Fintype β] [Fintype γ] (μ : FinProb α) (f : α → β)
    (g : β → γ) : (μ.map f).map g = μ.map (g ∘ f) := by
  apply FinProb.ext
  intro c
  simp only [FinProb.mass_map]
  calc
    (∑ b, if g b = c then ∑ a, if f a = b then μ.mass a else 0 else 0) =
        ∑ b, ∑ a, if g b = c then (if f a = b then μ.mass a else 0) else 0 := by
      apply Finset.sum_congr rfl
      intro b _
      by_cases hb : g b = c <;> simp [hb]
    _ = ∑ a, ∑ b, if g b = c then (if f a = b then μ.mass a else 0) else 0 :=
      Finset.sum_comm
    _ = ∑ a, if g (f a) = c then μ.mass a else 0 := by
      apply Finset.sum_congr rfl
      intro a _
      by_cases ha : g (f a) = c
      · rw [Finset.sum_eq_single (f a)]
        · simp [ha]
        · intro b _ hb
          simp [Ne.symm hb]
        · simp
      · rw [ite_eq_right ha]
        apply Finset.sum_eq_zero
        intro b _
        by_cases hb : f a = b
        · subst b
          simp [ha]
        · simp [hb]

lemma bind_map [Fintype α] [Fintype β] [Fintype γ] (μ : FinProb α) (f : α → β)
    (κ : β → FinProb γ) :
    (μ.map f).bind κ = μ.bind (fun a => κ (f a)) := by
  apply FinProb.ext
  intro c
  simp only [FinProb.mass_bind, FinProb.mass_map]
  calc
    (∑ b, (∑ a, if f a = b then μ.mass a else 0) * (κ b).mass c) =
        ∑ b, ∑ a, (if f a = b then μ.mass a else 0) * (κ b).mass c := by
      apply Finset.sum_congr rfl
      intro b _
      rw [Finset.sum_mul]
    _ = ∑ a, ∑ b, (if f a = b then μ.mass a else 0) * (κ b).mass c :=
      Finset.sum_comm
    _ = ∑ a, μ.mass a * (κ (f a)).mass c := by
      apply Finset.sum_congr rfl
      intro a _
      rw [Finset.sum_eq_single (f a)]
      · simp
      · intro b _ hb
        simp [Ne.symm hb]
      · simp

lemma exists_of_mass_map_ne_zero [Fintype α] [Fintype β] {μ : FinProb α}
    {f : α → β} {b : β} (h : (μ.map f).mass b ≠ 0) :
    ∃ a, μ.mass a ≠ 0 ∧ f a = b := by
  rw [FinProb.mass_map] at h
  by_contra hn
  apply h
  apply Finset.sum_eq_zero
  intro a _
  by_cases hfa : f a = b
  · by_cases ha : μ.mass a = 0
    · simp [hfa, ha]
    · exact (hn ⟨a, ha, hfa⟩).elim
  · simp [hfa]

lemma exists_of_mass_bind_ne_zero [Fintype α] [Fintype β] {μ : FinProb α}
    {κ : α → FinProb β} {b : β} (h : (μ.bind κ).mass b ≠ 0) :
    ∃ a, μ.mass a ≠ 0 ∧ (κ a).mass b ≠ 0 := by
  rw [FinProb.mass_bind] at h
  by_contra hn
  apply h
  apply Finset.sum_eq_zero
  intro a _
  by_cases ha : μ.mass a = 0
  · simp [ha]
  · by_cases hκ : (κ a).mass b = 0
    · simp [hκ]
    · exact (hn ⟨a, ha, hκ⟩).elim

namespace FinProb

variable [Fintype α] [Preorder α]

/-- A one-step coupling of two kernels on ordered input states. -/
structure OrderedKernelCoupling (K L : α → FinProb α) where
  law : α × α → FinProb (α × α)
  map_fst : ∀ a b, (law (a, b)).map Prod.fst = K a
  map_snd : ∀ a b, (law (a, b)).map Prod.snd = L b
  ordered : ∀ a b, a ≤ b → ∀ z, (law (a, b)).mass z ≠ 0 → z.1 ≤ z.2

namespace OrderedKernelCoupling

variable {K L : α → FinProb α}

/-- Compose a coupling of current laws with a coupling of transition kernels. -/
def bindOrdered {μ ν : FinProb α} (c : OpenPath.FinProb.OrderedCoupling μ ν)
    (s : OrderedKernelCoupling K L) :
    OpenPath.FinProb.OrderedCoupling (μ.bind K) (ν.bind L) where
  law := c.law.bind s.law
  fst := by
    rw [OpenPath.FinProb.map_bind]
    simp_rw [s.map_fst]
    rw [← GlauberCoupling.bind_map, c.fst]
  snd := by
    rw [OpenPath.FinProb.map_bind]
    simp_rw [s.map_snd]
    rw [← GlauberCoupling.bind_map, c.snd]
  ordered z hz := by
    obtain ⟨y, hy, hz⟩ := exists_of_mass_bind_ne_zero hz
    exact s.ordered y.1 y.2 (c.ordered y hy) z hz

end OrderedKernelCoupling
end FinProb

/-- Distribution generated by repeatedly applying a kernel on the right. -/
def iterateLaw [Fintype α] (μ : FinProb α) (K : α → FinProb α) : ℕ → FinProb α
  | 0 => μ
  | n + 1 => (iterateLaw μ K n).bind K

lemma iterateLaw_zero [Fintype α] (μ : FinProb α) (K : α → FinProb α) :
    iterateLaw μ K 0 = μ := rfl

lemma iterateLaw_succ [Fintype α] (μ : FinProb α) (K : α → FinProb α) (n : ℕ) :
    iterateLaw μ K (n + 1) = (iterateLaw μ K n).bind K := rfl

lemma iterate_one [Fintype α] (K : α → FinProb α) : Glauber.iterate K 1 = K := by
  funext a
  change (K a).bind (fun b => Glauber.FinProb.dirac b) = K a
  exact Glauber.FinProb.bind_dirac_right (K a)

lemma iterateLaw_eq_bind_iterate [Fintype α] (μ : FinProb α) (K : α → FinProb α) (n : ℕ) :
    iterateLaw μ K n = μ.bind (Glauber.iterate K n) := by
  induction n with
  | zero => exact (Glauber.FinProb.bind_dirac_right μ).symm
  | succ n ih =>
      calc
        iterateLaw μ K (n + 1) = (μ.bind (Glauber.iterate K n)).bind K := by rw [iterateLaw_succ, ih]
        _ = μ.bind (Glauber.seq (Glauber.iterate K n) K) := by
          exact Glauber.FinProb.bind_assoc μ (Glauber.iterate K n) K
        _ = μ.bind (Glauber.iterate K (n + 1)) := by
          rw [Glauber.iterate_add, iterate_one]

namespace FinProb

variable [Fintype α] [Preorder α]

/-- Diagonal ordered coupling of a finite law with itself. -/
def diagonalOrdered (μ : FinProb α) : OpenPath.FinProb.OrderedCoupling μ μ where
  law := μ.map fun a => (a, a)
  fst := by
    rw [map_map]
    apply FinProb.ext
    intro a
    simp [FinProb.mass_map]
  snd := by
    rw [map_map]
    apply FinProb.ext
    intro a
    simp [FinProb.mass_map]
  ordered z hz := by
    obtain ⟨a, _, rfl⟩ := exists_of_mass_map_ne_zero hz
    exact le_rfl

/-- Iterating ordered transition couplings gives ordered couplings at every
finite time, starting from a common law. -/
def orderedIterateLaw (μ : FinProb α) (K L : α → FinProb α)
    (s : OrderedKernelCoupling K L) : ∀ n : ℕ,
    OpenPath.FinProb.OrderedCoupling (iterateLaw μ K n) (iterateLaw μ L n)
  | 0 => diagonalOrdered μ
  | n + 1 => OrderedKernelCoupling.bindOrdered (orderedIterateLaw μ K L s n) s

lemma stochLe_iterateLaw (μ : FinProb α) (K L : α → FinProb α)
    (s : OrderedKernelCoupling K L) (n : ℕ) :
    OpenPath.FinProb.StochLe (iterateLaw μ K n) (iterateLaw μ L n) :=
  OpenPath.FinProb.stochLe_of_orderedCoupling (orderedIterateLaw μ K L s n)

end FinProb

section SingleEdge

variable {E : Type*} [Fintype E] [DecidableEq E] {B : Type*} [Fintype B]
  [Preorder B]

open Glauber

/-- Couple two one-edge heat-bath updates from arbitrary pairs of input
configurations using an ordered coupling of their conditional bit laws. -/
def edgeUpdateCoupling (c₁ c₂ : EdgeConditionals B E)
    (s : ∀ e off₁ off₂, OpenPath.FinProb.OrderedCoupling (c₁ e off₁) (c₂ e off₂))
    (e : E) : FinProb.OrderedKernelCoupling (edgeUpdate c₁ e) (edgeUpdate c₂ e) where
  law x := (s e (fun f => x.1 f.1) (fun f => x.2 f.1)).law.map
    (fun b => (Function.update x.1 e b.1, Function.update x.2 e b.2))
  map_fst a b := by
    rw [map_map]
    change (s e (fun f => a f.1) (fun f => b f.1)).law.map
      (Function.update a e ∘ Prod.fst) = edgeUpdate c₁ e a
    rw [← map_map, (s e (fun f => a f.1) (fun f => b f.1)).fst]
    exact (edgeUpdate_eq_map c₁ e a).symm
  map_snd a b := by
    rw [map_map]
    change (s e (fun f => a f.1) (fun f => b f.1)).law.map
      (Function.update b e ∘ Prod.snd) = edgeUpdate c₂ e b
    rw [← map_map, (s e (fun f => a f.1) (fun f => b f.1)).snd]
    exact (edgeUpdate_eq_map c₂ e b).symm
  ordered a b hab z hz := by
    obtain ⟨v, hv, rfl⟩ := exists_of_mass_map_ne_zero hz
    intro f
    by_cases hf : f = e
    · subst f
      simpa using (s e (fun f => a f.1) (fun f => b f.1)).ordered v hv
    · simpa [Function.update_of_ne hf] using hab f

/-- Use the same independent clock on the two coupled one-edge chains. -/
def pairJump (ρ : FinProb E) (c₁ c₂ : EdgeConditionals B E)
    (s : ∀ e off₁ off₂, OpenPath.FinProb.OrderedCoupling (c₁ e off₁) (c₂ e off₂)) :
    FinProb.OrderedKernelCoupling
      (mixture ρ (edgeUpdate c₁)) (mixture ρ (edgeUpdate c₂)) where
  law x := ρ.bind fun e => (edgeUpdateCoupling c₁ c₂ s e).law x
  map_fst a b := by
    rw [OpenPath.FinProb.map_bind]
    simp_rw [(edgeUpdateCoupling c₁ c₂ s _).map_fst]
    rfl
  map_snd a b := by
    rw [OpenPath.FinProb.map_bind]
    simp_rw [(edgeUpdateCoupling c₁ c₂ s _).map_snd]
    rfl
  ordered a b hab z hz := by
    obtain ⟨e, _, hz⟩ := exists_of_mass_bind_ne_zero hz
    exact (edgeUpdateCoupling c₁ c₂ s e).ordered a b hab z hz

end SingleEdge

end
end GlauberCoupling
