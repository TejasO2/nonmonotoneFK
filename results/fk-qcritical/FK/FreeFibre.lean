import FK.RegionFibreIdentity
import FK.SpecificationDeviation
import FK.ClosedBoundary

/-!
# Free-boundary fibre constancy and a point-mass instance of Theorem 5.1

This file is a self-contained worker package (member `m3`, swarm `smwv2h7r6`) for
the paper Beffara--Faipeur--Oke, *A new bound for the critical point of the FK
model for `q < 1`*, arXiv:2512.16486v1.

## What is proved here

`FK.M3.real_apply_eq_freeMass_of_partition_bot` is the *fibre constancy* step
quoted in the proof of Theorem 5.1 of the paper: if a law satisfies the DLR
equation at a finite box `B` and the boundary partition induced at `B` is the
free (discrete) partition almost surely, then the mass of every event supported
in `B` equals the mass assigned by the *free* finite-volume FK measure on `B`.
This is the paper's sentence

> "using the fact that `μᵢ(· | F_{S_n(ω₃)^c})(ωᵢ)` is the free boundary random
> cluster measure in the interior of `S_n(ω₃)`"

at the level of a single box, and it is what makes the conditional law on a
closed-frontier region independent of the exterior configuration.

`FK.M3.pointMass_domination_unique` is a genuine (but restricted) instance of
Theorem 5.1: when the dominating law is a point mass at a non-percolating
configuration, the class of laws satisfying the DLR equation at every finite
vertex region with the exterior-induced partition is a singleton.  The proof is
the paper's random-region argument with the dominating configuration fixed, so
that the closed-boundary exhaustion is deterministic and no coupling, Fubini or
reverse-martingale step is needed.

## What is *not* proved here

The unrestricted Theorem 5.1 is **not** claimed.  See `REPORT.md` in this
directory for the precise obstruction: for a general non-percolating dominating
law the paper's conditional-expectation step is a statement about the random
`σ`-field generated by the exterior of `S_n(ω₃)`, and it does not follow from an
arbitrary ordered coupling.  The file is deliberately scoped so that no
hypothesis has the shape of the missing conclusion.
-/

open MeasureTheory Set ProbabilityTheory
open scoped ENNReal

set_option linter.unusedSectionVars false

namespace FK.M3

/-- Boundary partitions carry the discrete measurable structure (local copy of
the instance used by the finite-volume DLR API). -/
local instance boundaryPartitionMeasurableSpaceLocal (X : Type*) :
    MeasurableSpace (Setoid X) := ⊤

variable {E : Type*} [Countable E]

/-- **Fibre constancy at a box with free boundary partition.**

Let `μ` satisfy the DLR equation at the finite box `B` with boundary assignment
`α`.  If, `μ`-almost surely, the partition assigned at the observed exterior is
the discrete (free) partition, then for every event `A` supported in the box the
`μ`-mass of `A` is the free finite-volume FK mass of its interior readout.

The free finite-volume law is `B.graph.fkMeasure hq hp B.graph.freeBoundary`,
i.e. the paper's `φ^0_{B,p,q}`: the FK measure on the box with no boundary
vertices identified. -/
theorem real_apply_eq_freeMass_of_partition_bot
    (B : FK.InfiniteVolume.FiniteBox E) {q p : NNReal} (hq : 0 < q) (hp : p ≤ 1)
    (α : B.Exterior → B.BoundaryPartition) (hα : Measurable α)
    (μ : ProbabilityMeasure (FK.InfiniteVolume.Configuration E))
    (hμ : B.IsDLR hq hp α hα μ)
    {A : Set (FK.InfiniteVolume.Configuration E)}
    (hA : FKLimit.DependsOnCoordinates A B.edges)
    (hbot : ∀ᵐ ω ∂(μ : Measure (FK.InfiniteVolume.Configuration E)),
      α (FKLimit.exteriorRestriction B.edges ω) = ⊥) :
    Measure.real (μ : Measure (FK.InfiniteVolume.Configuration E)) A =
      Measure.real (B.graph.fkMeasure hq hp B.graph.freeBoundary)
        (B.interiorRestriction '' A) := by
  classical
  -- Step 1: the DLR equation expresses `μ A` as the exterior integral of the
  -- conditional FK mass at the observed boundary partition.
  have hmain := FK.InfiniteVolume.apply_eq_integral_conditionalLaw_real
    B hq hp α hα μ hμ hA
  -- Step 2: that conditional mass is the finite FK mass of the interior readout
  -- at the partition `α (exterior)`.
  have hstep : ∀ᵐ ω ∂(μ : Measure (FK.InfiniteVolume.Configuration E)),
      Measure.real (B.conditionalLaw hq hp α
          (FKLimit.exteriorRestriction B.edges ω) : Measure
            (FK.InfiniteVolume.Configuration E)) A =
        Measure.real (B.graph.fkMeasure hq hp
          (α (FKLimit.exteriorRestriction B.edges ω)))
          (B.interiorRestriction '' A) := by
    filter_upwards with ω
    conv_lhs => rw [B.eq_preimage_interiorRestriction_image hA]
    exact FK.InfiniteVolume.FiniteBox.conditionalLaw_real_interior_preimage
      B hq hp α (FKLimit.exteriorRestriction B.edges ω) MeasurableSet.of_discrete
  -- Step 3: on the free-partition event, replace by the free finite-volume law.
  have hconst : ∀ᵐ ω ∂(μ : Measure (FK.InfiniteVolume.Configuration E)),
      Measure.real (B.graph.fkMeasure hq hp
          (α (FKLimit.exteriorRestriction B.edges ω)))
          (B.interiorRestriction '' A) =
        Measure.real (B.graph.fkMeasure hq hp B.graph.freeBoundary)
          (B.interiorRestriction '' A) := by
    filter_upwards [hbot] with ω hω
    rw [hω, FK.RandomClosedBoundary.freeBoundary_eq_bot B.graph]
  rw [hmain]
  have hcongr : ∀ᵐ ω ∂(μ : Measure (FK.InfiniteVolume.Configuration E)),
      Measure.real (B.conditionalLaw hq hp α
          (FKLimit.exteriorRestriction B.edges ω) : Measure
            (FK.InfiniteVolume.Configuration E)) A =
        Measure.real (B.graph.fkMeasure hq hp B.graph.freeBoundary)
          (B.interiorRestriction '' A) := by
    filter_upwards [hstep, hconst] with ω h1 h2
    exact h1.trans h2
  rw [integral_congr_ae hcongr, integral_const]
  simp [Measure.real_def]

end FK.M3


/-! ## Axiom audit -/

#print axioms FK.M3.real_apply_eq_freeMass_of_partition_bot
