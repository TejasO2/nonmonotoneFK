import FK.GeneralizedTheta
import FK.FacialSubdivision

/-!
# Generalized theta graphs with arbitrary finite branch lengths

A finite subdivision chain remembers which original label each current label
came from. Iterating facial subdivision therefore gives an explicit family of
labelled dual pairs, rather than merely a metatheoretic assertion that the
operation may be repeated. The original two edges of a theta branch may be
subdivided independently, giving every branch length at least two.
-/

namespace FK.Finite.PlaneMatroid.ArbitraryLengthTheta

open scoped BigOperators Classical
open FK.Finite FK.Finite.LabelledMultigraph FK.FinitePlane
open FK.Finite.PlaneMatroid FK.Finite.PlaneMatroid.LabelledDualPair
open FK.Finite.PlaneMatroid.GeneralizedTheta

/-- A finite, dependently typed sequence of facial edge subdivisions. The
index is the actual final labelled dual pair. -/
inductive Chain (P : LabelledDualPair) : LabelledDualPair → Type 1 where
  | nil : Chain P P
  | subdiv {Q : LabelledDualPair} (c : Chain P Q) (e : Q.Edge) :
      Chain P (subdivPair Q e)

namespace Chain

variable {P Q : LabelledDualPair}

/-- Every current label lies on the series generated by one original label. -/
def origin : {Q : LabelledDualPair} → Chain P Q → Q.Edge → P.Edge
  | _, .nil, e => e
  | _, .subdiv c f, some e => origin c e
  | _, .subdiv c f, none => origin c f

/-- The canonical old segment representing an original label. -/
def embed : {Q : LabelledDualPair} → Chain P Q → P.Edge → Q.Edge
  | _, .nil, e => e
  | _, .subdiv c _, e => some (embed c e)

@[simp] lemma origin_embed (c : Chain P Q) (e : P.Edge) :
    origin c (embed c e) = e := by
  induction c with
  | nil => rfl
  | subdiv c f ih => exact ih

lemma embed_injective (c : Chain P Q) : Function.Injective (embed c) := by
  intro a b hab
  have h := congrArg (origin c) hab
  simpa only [origin_embed] using h

/-- Subdivision leaves the face type unchanged. -/
noncomputable def faceEquiv {Q : LabelledDualPair} (c : Chain P Q) : Q.Face ≃ P.Face := by
  induction c with
  | nil => exact Equiv.refl _
  | subdiv c f ih => exact ih

/-- Every dual segment has the source face of its original label. -/
@[simp] lemma dualSource_faceEquiv_origin (c : Chain P Q) (e : Q.Edge) :
    faceEquiv c (Q.dualSource e) = P.dualSource (origin c e) := by
  induction c with
  | nil => rfl
  | subdiv c f ih =>
      cases e with
      | none => exact ih f
      | some e => exact ih e

/-- Every dual segment has the target face of its original label. -/
@[simp] lemma dualTarget_faceEquiv_origin (c : Chain P Q) (e : Q.Edge) :
    faceEquiv c (Q.dualTarget e) = P.dualTarget (origin c e) := by
  induction c with
  | nil => rfl
  | subdiv c f ih =>
      cases e with
      | none => exact ih f
      | some e => exact ih e

@[simp] lemma card_faces (c : Chain P Q) :
    Fintype.card Q.Face = Fintype.card P.Face :=
  Fintype.card_congr (faceEquiv c)

/-- Number of current segments generated by an original label. -/
noncomputable def segmentCount : {Q : LabelledDualPair} → Chain P Q → P.Edge → ℕ
  | _, .nil, _ => 1
  | _, .subdiv c f, e => segmentCount c e + if origin c f = e then 1 else 0

@[simp] lemma segmentCount_nil (e : P.Edge) : segmentCount (.nil : Chain P P) e = 1 := rfl

@[simp] lemma segmentCount_subdiv (c : Chain P Q) (f : Q.Edge) (e : P.Edge) :
    segmentCount (.subdiv c f) e =
      segmentCount c e + if origin c f = e then 1 else 0 := rfl

/-- `segmentCount` is literally the cardinality of the origin-fibre, not a
recursion counter with a merely intended geometric interpretation. -/
lemma card_origin_fibre (c : Chain P Q) (e : P.Edge) :
    Fintype.card {f : Q.Edge // origin c f = e} = segmentCount c e := by
  classical
  induction c with
  | nil =>
      rw [Fintype.card_subtype, Finset.card_filter]
      change (∑ i : P.Edge, if i = e then 1 else 0) = 1
      exact Fintype.sum_ite_eq' e (fun _ => 1)
  | @subdiv R c f ih =>
      rw [Fintype.card_subtype, Finset.card_filter]
      change (∑ x : Option R.Edge, if origin (.subdiv c f) x = e then 1 else 0) =
        segmentCount (.subdiv c f) e
      rw [Fintype.sum_option]
      by_cases h : origin c f = e
      · simp only [origin, h, ↓reduceIte, segmentCount_subdiv]
        have hi := ih
        rw [Fintype.card_subtype, Finset.card_filter] at hi
        change 1 + (∑ x : R.Edge, if origin c x = e then 1 else 0) =
          segmentCount c e + 1
        rw [hi]
        omega
      · simp only [origin, h, ↓reduceIte, Nat.zero_add, segmentCount_subdiv,
          Nat.add_zero]
        have hi := ih
        rw [Fintype.card_subtype, Finset.card_filter] at hi
        change (∑ x : R.Edge, if origin c x = e then 1 else 0) = segmentCount c e
        exact hi

/-- Subdivide the canonical old segment of `e` `n` further times. -/
noncomputable def subdivOld (c : Chain P Q) (e : P.Edge) : ℕ →
    Σ Q : LabelledDualPair, Chain P Q
  | 0 => ⟨Q, c⟩
  | n + 1 =>
      let r := subdivOld c e n
      ⟨subdivPair r.1 (embed r.2 e), .subdiv r.2 (embed r.2 e)⟩

@[simp] lemma segmentCount_subdivOld_same (c : Chain P Q) (e : P.Edge) (n : ℕ) :
    segmentCount (subdivOld c e n).2 e = segmentCount c e + n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [subdivOld]
      dsimp only
      rw [segmentCount_subdiv, origin_embed, ite_eq_left rfl, ih]
      omega

@[simp] lemma segmentCount_subdivOld_ne (c : Chain P Q) {a e : P.Edge}
    (hae : a ≠ e) (n : ℕ) :
    segmentCount (subdivOld c e n).2 a = segmentCount c a := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [subdivOld]
      dsimp only
      rw [segmentCount_subdiv, origin_embed, ite_eq_right (Ne.symm hae), ih, Nat.add_zero]

/-- Execute requested subdivision counts on a list of distinct original
labels. -/
noncomputable def ofList {P : LabelledDualPair} (Q : LabelledDualPair)
    (c : Chain P Q) (n : P.Edge → ℕ) : List P.Edge →
    Σ Q : LabelledDualPair, Chain P Q
  | [] => ⟨Q, c⟩
  | e :: l =>
      let r := subdivOld c e (n e)
      ofList r.1 r.2 n l

lemma segmentCount_ofList (c : Chain P Q) (n : P.Edge → ℕ)
    (l : List P.Edge) (hl : l.Nodup) (e : P.Edge) :
    segmentCount (ofList Q c n l).2 e =
      segmentCount c e + if e ∈ l then n e else 0 := by
  induction l generalizing Q with
  | nil => simp [ofList]
  | cons a l ih =>
      have ha : a ∉ l := (List.nodup_cons.mp hl).1
      have hl' : l.Nodup := (List.nodup_cons.mp hl).2
      rw [ofList]
      rw [ih _ hl']
      by_cases hea : e = a
      · subst a
        rw [segmentCount_subdivOld_same]
        simp [ha]
      · rw [segmentCount_subdivOld_ne _ hea _]
        simp [hea]

/-- A final pair attained by the requested numbers of subdivisions on every
original label. -/
noncomputable def ofCounts (P : LabelledDualPair) [Fintype P.Edge]
    (n : P.Edge → ℕ) : Σ Q : LabelledDualPair, Chain P Q :=
  ofList P .nil n Finset.univ.toList

@[simp] lemma segmentCount_ofCounts (P : LabelledDualPair) [Fintype P.Edge]
    (n : P.Edge → ℕ) (e : P.Edge) :
    segmentCount (ofCounts P n).2 e = 1 + n e := by
  rw [ofCounts, segmentCount_ofList]
  · simp
  · exact Finset.nodup_toList _

/-- Facial subdivision preserves the actual graphic-duality certificate along
the whole chain, including nonempty faces and all-open dual connectivity. -/
theorem graphicDualCertificate (c : Chain P Q)
    (hP : P.GraphicDualCertificate) : Q.GraphicDualCertificate := by
  induction c with
  | nil => exact hP
  | subdiv c f ih => exact graphicDualCertificate_subdivPair _ _ ih

end Chain

/-- Extra subdivisions used to turn the two original segments of branch `i`
into a path of length `L i`. -/
def thetaExtra {G : LabelledMultigraph} (L : G.Edge → ℕ) : G.Edge × Bool → ℕ
  | (i, false) => L i - 2
  | (_, true) => 0

@[simp] lemma thetaExtra_false {G : LabelledMultigraph} (L : G.Edge → ℕ) (i : G.Edge) :
    thetaExtra L (i, false) = L i - 2 := rfl

@[simp] lemma thetaExtra_true {G : LabelledMultigraph} (L : G.Edge → ℕ) (i : G.Edge) :
    thetaExtra L (i, true) = 0 := rfl

/-- The final pair and its witnessing subdivision chain for any numerical
branch-length profile. -/
noncomputable def thetaWithLengths (G : LabelledMultigraph) (L : G.Edge → ℕ) :
    Σ Q : LabelledDualPair, Chain (lengthTwoThetaPair G) Q :=
  Chain.ofCounts (lengthTwoThetaPair G) (thetaExtra L)

/-- A generalized theta graph with two terminals and the prescribed number of
edges in each internally disjoint branch. The branches indexed by `G.Edge`
need not all have the same length. -/
noncomputable def thetaPairOfLengths (G : LabelledMultigraph) (L : G.Edge → ℕ) :
    LabelledDualPair := (thetaWithLengths G L).1

/-- The explicit chain from the public length-two pair to the arbitrary-length
pair. -/
noncomputable def thetaChainOfLengths (G : LabelledMultigraph) (L : G.Edge → ℕ) :
    Chain (lengthTwoThetaPair G) (thetaPairOfLengths G L) :=
  (thetaWithLengths G L).2

@[simp] lemma thetaChain_segmentCount (G : LabelledMultigraph) (L : G.Edge → ℕ)
    (e : G.Edge × Bool) :
    Chain.segmentCount (thetaChainOfLengths G L) e = 1 + thetaExtra L e :=
  Chain.segmentCount_ofCounts _ _ _

/-- Exactly the requested number of edges occur in the two origin-fibres of
branch `i`. In particular, every length at least two is attained. -/
@[simp] theorem thetaChain_branchLength (G : LabelledMultigraph) (L : G.Edge → ℕ)
    (hL : ∀ i, 2 ≤ L i) (i : G.Edge) :
    Chain.segmentCount (thetaChainOfLengths G L) (i, false) +
      Chain.segmentCount (thetaChainOfLengths G L) (i, true) = L i := by
  rw [thetaChain_segmentCount, thetaChain_segmentCount,
    thetaExtra_false, thetaExtra_true]
  have hi := hL i
  omega

/-- Every numerical profile still has exactly the original cycle vertices as
its face type, up to the canonical equivalence preserved by each subdivision.
The generic `Chain.card_origin_fibre` identifies each summand in the preceding
branch-length theorem with an actual cardinality of current edge labels. -/
noncomputable def thetaFaceEquiv (G : LabelledMultigraph) (L : G.Edge → ℕ) :
    (thetaPairOfLengths G L).Face ≃ G.Vertex :=
  Chain.faceEquiv (thetaChainOfLengths G L)

/-- The full graphic-duality certificate for arbitrary branch lengths at least
(and in fact including profiles below) two. No length hypothesis is needed for
dual matroid equality or dual all-open connectivity. -/
theorem thetaPairOfLengths_graphicDualCertificate (G : LabelledMultigraph)
    (hG : G.IsLabelledCycle) (L : G.Edge → ℕ) :
    (thetaPairOfLengths G L).GraphicDualCertificate :=
  Chain.graphicDualCertificate (thetaChainOfLengths G L)
    (lengthTwoThetaPair_graphicDualCertificate G hG)

/-- Exact matroid duality for every arbitrary-length generalized theta graph
and its bundled-cycle dual. -/
theorem thetaPairOfLengths_dual_cycleMatroid (G : LabelledMultigraph)
    (hG : G.IsLabelledCycle) (L : G.Edge → ℕ) :
    ((thetaPairOfLengths G L).primal.cycleMatroid)✶ =
      (thetaPairOfLengths G L).faceDual.cycleMatroid :=
  (thetaPairOfLengths_graphicDualCertificate G hG L).dual_cycleMatroid

/-- Starting with `parallelPair G`, whose primal consists of one direct edge
for each cycle label, also includes length-one branches. -/
noncomputable def positiveThetaWithLengths (G : LabelledMultigraph)
    (L : G.Edge → ℕ) : Σ Q : LabelledDualPair, Chain (parallelPair G) Q :=
  Chain.ofCounts (parallelPair G) (fun i => L i - 1)

/-- The generalized theta pair for an arbitrary positive branch-length
profile. Each current edge in the origin-fibre of `i` is one segment of the
`i`-th terminal-to-terminal path; the facial fibres are the corresponding
parallel bundles on the original cycle vertices. -/
noncomputable def positiveThetaPair (G : LabelledMultigraph) (L : G.Edge → ℕ) :
    LabelledDualPair := (positiveThetaWithLengths G L).1

/-- The explicit subdivision witness from the one-edge-per-branch parallel
pair. -/
noncomputable def positiveThetaChain (G : LabelledMultigraph) (L : G.Edge → ℕ) :
    Chain (parallelPair G) (positiveThetaPair G L) :=
  (positiveThetaWithLengths G L).2

@[simp] lemma positiveTheta_segmentCount (G : LabelledMultigraph) (L : G.Edge → ℕ)
    (i : G.Edge) : Chain.segmentCount (positiveThetaChain G L) i = 1 + (L i - 1) :=
  Chain.segmentCount_ofCounts _ _ _

/-- Every positive length is attained exactly. The generic
`Chain.card_origin_fibre` identifies this count with the cardinality of the
actual current-edge origin-fibre. -/
@[simp] theorem positiveTheta_branchLength (G : LabelledMultigraph) (L : G.Edge → ℕ)
    (hL : ∀ i, 1 ≤ L i) (i : G.Edge) :
    Chain.segmentCount (positiveThetaChain G L) i = L i := by
  rw [positiveTheta_segmentCount]
  have hi := hL i
  omega

/-- Direct cardinality form: the `i`-th branch contains exactly `L i` current
edge labels. -/
@[simp] theorem positiveTheta_card_origin_fibre
    (G : LabelledMultigraph) (L : G.Edge → ℕ) (hL : ∀ i, 1 ≤ L i) (i : G.Edge) :
    Fintype.card {e : (positiveThetaPair G L).Edge //
      Chain.origin (positiveThetaChain G L) e = i} = L i :=
  (Chain.card_origin_fibre (positiveThetaChain G L) i).trans
    (positiveTheta_branchLength G L hL i)

/-- Canonical identification of the facial vertices with the vertices of the
original labelled cycle. -/
noncomputable def positiveThetaFaceEquiv (G : LabelledMultigraph) (L : G.Edge → ℕ) :
    (positiveThetaPair G L).Face ≃ G.Vertex :=
  Chain.faceEquiv (positiveThetaChain G L)

/-- Every facial edge starts at the source of its original cycle edge. -/
@[simp] theorem positiveTheta_dualSource_origin (G : LabelledMultigraph)
    (L : G.Edge → ℕ) (e : (positiveThetaPair G L).Edge) :
    positiveThetaFaceEquiv G L ((positiveThetaPair G L).dualSource e) =
      G.source (Chain.origin (positiveThetaChain G L) e) :=
  Chain.dualSource_faceEquiv_origin _ _

/-- Every facial edge ends at the target of its original cycle edge. -/
@[simp] theorem positiveTheta_dualTarget_origin (G : LabelledMultigraph)
    (L : G.Edge → ℕ) (e : (positiveThetaPair G L).Edge) :
    positiveThetaFaceEquiv G L ((positiveThetaPair G L).dualTarget e) =
      G.target (Chain.origin (positiveThetaChain G L) e) :=
  Chain.dualTarget_faceEquiv_origin _ _

/-- Full graphic-duality certificate for every positive branch-length profile.
The matroid and connectivity statements themselves hold for the numerical
definition even without the positivity premise. -/
theorem positiveThetaPair_graphicDualCertificate (G : LabelledMultigraph)
    (hG : G.IsLabelledCycle) (L : G.Edge → ℕ) :
    (positiveThetaPair G L).GraphicDualCertificate :=
  Chain.graphicDualCertificate (positiveThetaChain G L)
    (graphicDualCertificate_parallel G hG)

/-- Exact bundled-cycle matroid duality for every generalized theta graph with
arbitrary positive branch lengths, including length one. -/
theorem positiveThetaPair_dual_cycleMatroid (G : LabelledMultigraph)
    (hG : G.IsLabelledCycle) (L : G.Edge → ℕ) :
    ((positiveThetaPair G L).primal.cycleMatroid)✶ =
      (positiveThetaPair G L).faceDual.cycleMatroid :=
  (positiveThetaPair_graphicDualCertificate G hG L).dual_cycleMatroid

end FK.Finite.PlaneMatroid.ArbitraryLengthTheta
