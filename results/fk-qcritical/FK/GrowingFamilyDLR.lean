import FK.NestedFiniteDLR
import FK.DLROnePoint
import FK.NoncoherentStabilization
import FK.NestedMixture.Limit

/-! Finite-stage DLR equations for arbitrary boundary schedules on a growing family. -/

open Filter Set MeasureTheory ProbabilityTheory Topology
open scoped ENNReal NNReal Classical BigOperators

namespace FK.NestedFinDLR

open FK.InfiniteVolume
open FK.NestedMixture
open ConventionGeometry ConventionTransport
open NoncoherentStabilization

universe u v

variable {E : Type u} [Countable E]

/-- The exterior-induced specifications generated by one outer finite-volume
boundary partition at each index of a growing family.  The value away from the
nested range is inert; all limiting statements quantify eventually over it. -/
noncomputable def inducedAssignments (F : GrowingFamily.{u, v} E)
    (a : ∀ n, (F.box n).BoundaryPartition) (n : ℕ) : BoundaryAssignment F.box where
  partition m := if h : m ≤ n then inducedBoundary (F.nest m n h) (a n) else
    fun _ => (F.box m).graph.freeBoundary
  measurable_partition m := by
    by_cases h : m ≤ n
    · simpa only [h, dite_true] using measurable_inducedBoundary (F.nest m n h) (a n)
    · simp only [h, dite_false]
      exact measurable_const

lemma inducedAssignments_partition_of_le (F : GrowingFamily.{u, v} E)
    (a : ∀ n, (F.box n).BoundaryPartition) {m n : ℕ} (h : m ≤ n) :
    (inducedAssignments F a n).partition m = inducedBoundary (F.nest m n h) (a n) := by
  simp only [inducedAssignments, h, dite_true]

/-- The finite-stage local DLR obligations of the noncoherent limit theorem are
consequences of the genuine nested-box data, for every arbitrary boundary schedule. -/
theorem eventually_isDLR_finiteVolumeLaw_growingFamily
    (F : GrowingFamily.{u, v} E) {q p : NNReal} (hq : 0 < q) (hp₀ : 0 < p) (hp₁ : p < 1)
    (a : ∀ n, (F.box n).BoundaryPartition) :
    ∀ m, ∀ᶠ n in atTop, (F.box m).IsDLR hq hp₁.le
      ((inducedAssignments F a n).partition m)
      ((inducedAssignments F a n).measurable_partition m)
      ((F.box n).finiteVolumeLaw hq hp₁.le (a n)) := by
  intro m
  filter_upwards [eventually_ge_atTop m] with n hmn
  simpa only [inducedAssignments, hmn, dite_true] using
    isDLR_finiteVolumeLaw_nested (N := F.nest m n hmn) (hq := hq)
      (hp₀ := hp₀) (hp₁ := hp₁) (a n)

/-- Exact one-edge finite-stage identities for every nested pair of a growing
family.  The connection event is the actual induced-specification event, so no
additional `hfin` or `hrate` binder is needed by the moving-rate machinery. -/
theorem onePoint_twoValuedRate_growingFamily
    (F : GrowingFamily.{u, v} E) {q p : NNReal} (hq : 0 < q) (hp₀ : 0 < p) (hp₁ : p < 1)
    (a : ∀ n, (F.box n).BoundaryPartition) {m n : ℕ} (hmn : m ≤ n)
    (e : (F.box m).edges)
    (g : (F.box m).Exterior × Glauber.OffConfig Bool (F.box m).edges e → ℝ≥0∞)
    (hg : Measurable g) :
    ∫⁻ ω, (bif (F.box m).splitBit e ω then g ((F.box m).splitOff e ω) else 0)
        ∂((F.box n).finiteVolumeLaw hq hp₁.le (a n) : Measure (Configuration E)) =
      ∫⁻ ω, ENNReal.ofReal (OneEdgeNoEscape.twoValuedRate (p : ℝ) (FK.prime (q : ℝ) (p : ℝ))
        (MovingClopenRate.FiniteBox.specificationConnectionEvent (F.box m)
          ((inducedAssignments F a n).partition m) e) ω) * g ((F.box m).splitOff e ω)
        ∂((F.box n).finiteVolumeLaw hq hp₁.le (a n) : Measure (Configuration E)) := by
  have hD : (F.box m).IsDLR hq hp₁.le
      ((inducedAssignments F a n).partition m)
      ((inducedAssignments F a n).measurable_partition m)
      ((F.box n).finiteVolumeLaw hq hp₁.le (a n)) := by
    simpa only [inducedAssignments, hmn, dite_true] using
      isDLR_finiteVolumeLaw_nested (N := F.nest m n hmn) (hq := hq)
        (hp₀ := hp₀) (hp₁ := hp₁) (a n)
  exact MovingClopenRate.FiniteBox.onePoint_twoValuedRate_of_isDLR (F.box m)
    hq hp₀ hp₁ ((inducedAssignments F a n).partition m)
    ((inducedAssignments F a n).measurable_partition m) _ hD e g hg

/-- Noncoherent weak-limit closure on a genuine nested growing family.  All
finite-stage DLR identities are derived.  The only remaining analytic input is
the explicitly stated joint stabilization of those induced specifications;
global at-most-one-cluster uniqueness is included as an actual hypothesis. -/
theorem mem_dlrMeasures_of_isFKLimit_growingFamily_of_locallyStabilizes_of_globalAtMostOne
    {V : Type u} {G : SimpleGraph V} [Countable V] [G.LocallyFinite]
    (F : GrowingFamily.{u, u} G.edgeSet)
    (data : SimpleGraphBoxData G F.box)
    {q p : NNReal} (hq : 0 < q) (hp₀ : 0 < p) (hp₁ : p < 1)
    (a : ∀ n, (F.box n).BoundaryPartition)
    (β : BoundaryAssignment F.box)
    (hβ : IsGeometric data.geometry β)
    {μ : ProbabilityMeasure (Configuration G.edgeSet)}
    (hμ : IsFKLimit F.exh hq hp₁.le a μ)
    (hstab : ∀ m, LocallyStabilizes atTop
      ((F.box m).exteriorMeasure μ : Measure (F.box m).Exterior)
      (fun n => (inducedAssignments F a n).partition m) (β.partition m))
    (hglobal : ∀ᵐ ω ∂(μ : Measure (Configuration G.edgeSet)), GlobalAtMostOne G ω) :
    μ ∈ DLRMeasures F.exh β hq hp₁.le := by
  exact NoncoherentStabilization.mem_dlrMeasures_of_isFKLimit_of_locallyStabilizes_of_globalAtMostOne
    F.exh data hq hp₀ hp₁ a (inducedAssignments F a) β hβ hμ
    (eventually_isDLR_finiteVolumeLaw_growingFamily F hq hp₀ hp₁ a) hstab hglobal

end FK.NestedFinDLR
